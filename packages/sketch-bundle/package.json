{
  "name": "@aisketch/sketch-bundle",
  "version": "0.3.0",
  "description": "AISketch bundle: mounts the sketch_function tool, its browser card, and the generic show_card card channel into a dsh profile",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@aisketch/sketch-tool": "workspace:*",
    "@aisketch/client-ui-sketch": "workspace:*",
    "@aisketch/cards-tool": "workspace:*",
    "@aisketch/client-ui-cards": "workspace:*",
    "@deepseek-ai/cordis": "4.0.4"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "QinLuza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QinLuza/dsh-aisketch.git"
  },
  "homepage": "https://github.com/QinLuza/dsh-aisketch#readme",
  "bugs": {
    "url": "https://github.com/QinLuza/dsh-aisketch/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "show-card",
    "function-plot",
    "table",
    "flowchart",
    "draw",
    "figure",
    "visualization",
    "bundle"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.2 <0.2.0"
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ]
}
