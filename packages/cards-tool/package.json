  "description": "Model-facing show_card tool: emits a versioned declarative CardSpec the conversation renders natively, instead of generated HTML",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
