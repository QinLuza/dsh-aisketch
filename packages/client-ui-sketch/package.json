{
  "name": "@gk/client-ui-sketch",
  "version": "0.1.0",
  "description": "AISketch browser card: renders the sketch_function tool view as a live Canvas plot",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node build-client.mjs"
  },
  "dependencies": {
    "@gk/sketch-core": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.7-rc.2",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.12",
    "react": "^18.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "author": "QinLuza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QinLuza/dsh-aisketch.git"
  },
  "homepage": "https://github.com/QinLuza/dsh-aisketch#readme",
  "bugs": {
    "url": "https://github.com/QinLuza/dsh-aisketch/issues"
  }
}
