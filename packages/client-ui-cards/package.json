{
  "name": "@aisketch/client-ui-cards",
  "version": "0.3.0",
  "description": "Generic in-conversation card renderer: one chat node kind keyed by CardSpec.kind, dispatched through a client-side renderer registry",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node build-client.mjs"
  },
  "dependencies": {
    "@aisketch/cards-core": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.25.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "author": "QinLuza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QinLuza/dsh-aisketch.git"
  },
  "homepage": "https://github.com/QinLuza/dsh-aisketch#readme",
  "bugs": {
    "url": "https://github.com/QinLuza/dsh-aisketch/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "card",
    "renderer",
    "svg",
    "table",
    "flowchart",
    "figure",
    "cards",
    "react"
  ]
}
