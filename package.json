{
  "name": "dsh-aisketch",
  "version": "0.2.0",
  "private": true,
  "description": "AISketch for DSH: semantic conversation cards (table, flowchart, hand-drawn draw, teaching figures) plus expression-driven function plots, with zero base changes",
  "license": "MIT",
  "author": "QinLuza",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QinLuza/dsh-aisketch.git"
  },
  "homepage": "https://github.com/QinLuza/dsh-aisketch#readme",
  "bugs": {
    "url": "https://github.com/QinLuza/dsh-aisketch/issues"
  },
  "scripts": {
    "test": "pnpm -r --no-bail run test",
    "typecheck": "pnpm -r --no-bail run typecheck",
    "build:client": "pnpm --filter @aisketch/client-ui-sketch --filter @aisketch/client-ui-cards run build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "show-card",
    "table",
    "flowchart",
    "draw",
    "figure",
    "function-plot",
    "visualization",
    "svg",
    "teaching",
    "diagram"
  ],
  "engines": {
    "node": ">=22"
  }
}
